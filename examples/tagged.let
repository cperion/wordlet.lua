-- A conditional that selects between two different callables builds one tagged callable. The tag
-- names the code to run and the payload is that code environment, so a call test the tag and then
-- runs the arm own body directly.
--
-- The reference interpreter resolves the arm while compiling with a concrete condition, so the
-- values below are the plain direct-call semantics of each arm.
--
-- Expected: pick(true) = 11          pick(false) = 9
--           scaled(true, 5) = 11     scaled(false, 5) = 4
--           across(true, 4) = 5      across(false, 4) = 12

let inc(x: u32): u32 = x + 1
let dec(x: u32): u32 = x - 1

-- Two named words: no environment, one tag each.
let pick(c: bool): u32 = do
  let f = if c then inc else dec
  return f(10)
end

-- Two lambdas that capture the same shape but differ in code, so each arm carries its environment.
let scaled(c: bool, x: u32): u32 = do
  let f = if c then |y: u32| -> y + x else |y: u32| -> y * 2
  return f(f(1))
end

-- A tagged callable whose tag is only known at the call site. An unannotated result infers the
-- tagged type, so the value crosses a call boundary intact.
let mk(c: bool) = if c then inc else |y: u32| -> y * 3
let across(c: bool, x: u32): u32 = do
  let f = mk(c)
  return f(x)
end

return { functions = { pick, scaled, across, mk } }
