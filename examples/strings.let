-- A slice is a runtime-length view of storage someone else owns, and a string is a slice of bytes.
-- A view borrows; it never owns, and nothing here allocates.
--
-- Expected: byte_at("A",0)=65   length_of("hello")=5   same()=true      different()=false
--           escaped()=4         empty_length()=0      module_view(1)=20  sliced_sum()=60
--           count_a("banana",0)=3  banner_length()=13  banner_first()=102  banner_is_raw()=4

let byte_at(s: String, i: U32) : U32 = U32(s[i])
let length_of(s: String) : U32 = s.length

-- A byte literal is one byte written readably, and it adapts like any other numeric literal.
let count_from(s: String, b: U8, i: U32) : U32 = do
  if i >= s.length then return 0 end
  if s[i] == b then return 1 + count_from(s, b, i + 1) end
  return count_from(s, b, i + 1)
end

-- The starting position is a run-time value, so the recursion consumes the view instead of growing a
-- specialization: a recursive word whose static arguments change specializes once per value.
let count_a(s: String, i: U32) : U32 = count_from(s, 'a', i)

-- A byte sequence has no identity a program can observe, so `==` compares content.
let same() : Bool = "hello" == "hello"
let different() : Bool = "hello" == "world"

-- Escapes decode to bytes, a literal may be empty, and digits may be grouped to be read.
let escaped() : U32 = "a\tb\n".length
let empty_length() : U32 = "".length
let grouped() : U32 = 1_000_000 + 0b1010_1010

-- A long string is raw and may span lines. One newline after the opening bracket is dropped, so a body
-- can begin on the line below it, and the level lets the body contain a bracket of its own.
let banner = [=[
first
second
]=]

let banner_length() : U32 = banner.length
let banner_first() : U32 = U32(banner[0])
let banner_is_raw() : U32 = [=[a\tb]=].length

-- An array in module storage, viewed at a runtime length. A view of module storage may be returned.
let xs = [10, 20, 30]
let view() : Slice(U32) = Slice(xs)
let module_view(i: U32) : U32 = view()[i]

-- A slice parameter: the callee does not know its length while compiling, so it reads the length and
-- checks each index when it runs.
let sum_three(v: Slice(U32)) : U32 = do
  let n = v.length
  if n < 3 then return 0 end
  return v[0] + v[1] + v[2]
end

let sliced_sum() : U32 = do
  let three = [10, 20, 30]
  return sum_three(Slice(three))
end

return {
  functions = { byte_at, length_of, count_a, same, different, escaped, empty_length, grouped,
    banner_length, banner_first, banner_is_raw, module_view, sliced_sum },
}
