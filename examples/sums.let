-- Sum types: one keyed schema of alternatives, constructed by member selection and consumed by
-- exhaustive keyed application. Nothing here needs new surface syntax.
--
-- area takes its Shape at run time, so its match becomes a C tag test with the payload projected
-- inside each arm; area_of_circle and area_of_round build a known tag, so their match is resolved
-- while compiling and only the handler for that alternative is elaborated.
--
-- Expected: area_of_circle(5) = 25
--           area_of_round(6)  = 36   (a circle of radius 6)
--           area_of_box(4)    = 12   (a rectangle 4 wide and 3 high)
--           scaled(3)         = 36   (a rectangle 3 wide and 12 high)
--           total(0)          = 6    (a rectangle 2 wide and 3 high)
--           total(4)          = 16   (a circle of radius 4)
--           unwrap_or(0, 9)   = 9    (the Unit alternative supplies the fallback)
--           unwrap_or(4, 9)   = 4

let Circle = { radius: U32 }
let Rect = { width: U32, height: U32 }

let Shape = OneOf({ circle: Circle, rect: Rect })

-- One handler per alternative. The payload arrives as that handler argument.
let area(s: Shape): U32 = s {
  circle = |c: Circle| -> c.radius * c.radius,
  rect = |r: Rect| -> r.width * r.height,
}

let round(radius: U32): Shape = Shape.circle { radius = radius }
let box(width: U32, height: U32): Shape = Shape.rect { width = width, height = height }

let area_of_circle(radius: U32): U32 = area(Shape.circle { radius = radius })
let area_of_round(radius: U32): U32 = area(round(radius))
let area_of_box(width: U32): U32 = area(box(width, 3))

-- An alternative chosen by a run-time condition is still matched exhaustively.
let scaled(n: U32): U32 = area(if n == 0 then box(n + 2, 3) else box(n, n * 4))
let total(n: U32): U32 = area(if n == 0 then box(n + 2, 3) else round(n))

-- A Unit alternative carries no payload, so its handler receives nothing to use.
let Opt = OneOf({ none: Unit, some: U32 })
let or_else(o: Opt, fallback: U32): U32 = o {
  none = |absent: Unit| -> fallback,
  some = |present: U32| -> present,
}
let unwrap_or(n: U32, fallback: U32): U32 = or_else(if n == 0 then Opt.none() else Opt.some(n), fallback)

return {
  types = { Circle, Rect, Shape, Opt },
  functions = { area, round, box, area_of_circle, area_of_round, area_of_box, scaled, total, unwrap_or },
}
